{
  "default_profile": "legacy-linux",
  "profiles": {
    "legacy-linux": {
      "host": "legacy-host",
      "port": 22,
      "user": "remote-user",
      "root": "/home/remote-user/project",
      "batch_mode": true,
      "strict_host_key": "yes",
      "connection_policy": {
        "mode": "broker",
        "exec_concurrency": 2,
        "min_connect_interval": 10,
        "connect_retries": 0,
        "auto_reconnect": false,
        "cooldown_initial": 60,
        "cooldown_max": 1800,
        "control_master": true
      },
      "ssh_args": [
        "-o",
        "ServerAliveInterval=60",
        "-o",
        "ServerAliveCountMax=5"
      ]
    }
  }
}
